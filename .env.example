# Copy these values into your deployment environment and replace the secret.
SECRET_KEY=replace-with-a-long-random-secret
ATTENDANCE_DB=attendance.db
# For local WebAuthn testing, open http://localhost:5000 (not the raw IP address).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000
# Starting OpenCV LBPH distance limit for optional face matching; validate per deployment.
FACE_MATCH_MAX_DISTANCE=55
